# Folder on the Docker HOST where ZIM files are written (your Kiwix library).
# Linux:   LIBRARY_HOST_PATH=/srv/kiwix/library
# Windows: LIBRARY_HOST_PATH=C:\Users\you\kiwix-library
LIBRARY_HOST_PATH=

# Folder on the Docker HOST for "File mirror" downloads. Keep it OUTSIDE the
# library folder so Kiwix doesn't see these files.
# Linux:   MIRROR_HOST_PATH=/srv/mirrors
# Windows: MIRROR_HOST_PATH=C:\Users\you\mirrors
MIRROR_HOST_PATH=

# Optional: name of your kiwix-serve container, restarted after each new ZIM.
# KIWIX_CONTAINER=kiwix-serve

# Optional login for the web page (username is "admin").
ZIMFORGE_PASSWORD=

# Optional limits so a big crawl can't take over the machine.
# SCRAPER_MEMORY=8g
# SCRAPER_CPUS=4
